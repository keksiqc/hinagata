{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>umicloud/renovate-config"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "packageRules": [
    {
      "description": "Keep the minimum versions of runtime dependencies wide, so installing hinagata does not force users to upgrade packages they share with other tools",
      "matchManagers": ["pep621"],
      "matchDepTypes": ["project.dependencies"],
      "rangeStrategy": "update-lockfile"
    }
  ],
  "customManagers": [
    {
      "description": "Track the frozen hook revisions in prek.toml, which the pre-commit manager does not read",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)prek\\.toml$/"],
      "matchStrings": [
        "repo = \"https://github\\.com/(?<depName>[^\"]+)\"\\s+rev = \"(?<currentDigest>[a-f0-9]{40})\"\\s+# frozen: (?<currentValue>v?\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "github-tags"
    }
  ]
}
